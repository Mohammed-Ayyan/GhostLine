# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution & build artifacts
dist/
build/
release_dist/
release_archive/
ghostline_archive/
website_download/
*.egg-info/
*.spec.bak
*.bundle
Ghostline-Setup.spec
Ghostline-Setup.exe
*.zip
*.mp4
recordings/
backups/
brag-output*/

# Large binary models
ghostline/models/tiny/model.bin
*.bin
*.onnx

# Temporary files, prompts & logs
*.log
*.tmp
prompt_*.txt
diag.txt
warn-*.txt
xref-*.html
app_test_err.log
app_test_out.log
exe_stderr.log
exe_stdout.log
stderr.log
stdout.log
test_ocr_temp.png
test_offline_temp.png
scratch/

# Environments & secrets
.env
.env.*
.venv/
venv/
env/
ENV/

# User-specific runtime data (stored in %APPDATA%\Ghostline)
config.json
history.jsonl

# IDE & OS files
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Legacy directories
rubric_local_app/
rubric_extracted/

# Agent, reports, shots, and backups
.agent/
.agents/
reports/
ui_shots/
website/screenshots/
ghostline_backups/
ui_inventory_*.json

# Keep required binaries, small test fixtures, icons, and website media
!**/bin/win_ocr.exe
!**/ghostline/fixtures/test_speech.wav
!**/ghostline.ico
!website/media/*.mp4
